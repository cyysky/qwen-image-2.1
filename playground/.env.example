# Copy to .env and edit. Nothing here is baked into the code.

# Format: name|base_url|api_key|label. The api_key may also be given out of
# band as API_KEY_<NAME>. Add local|http://127.0.0.1:7853/v1 if you run a local server.
IMAGE_ENDPOINTS=remote|http://10.0.151.2:7853/v1||Qwen-Image-2.1 10.0.151.2:7853,pixel-space|https://router.pixel-space.co/|sk-your-router-key|Pixel-Space Router
API_KEY_PIXEL_SPACE=sk-your-router-key
DEFAULT_ENDPOINT=remote
APPEND_V1=true

IMAGE_MODEL=Qwen-Image-2.1
IMAGE_MODELS=Qwen-Image-2.1
DEFAULT_IMAGE_MODEL=Qwen-Image-2.1

ENHANCER_ENABLED=true
# Comma separated enhancer engine keys, in UI order. The first one is the default.
# Built in engines: ds4-flash (chat model), pe-t2i (Qwen-Image-2.1-PE-T2I) and
# pe-i2i (Qwen-Image-2.1-PE-I2I, the edit checkpoint).
# Each key is configured with ENHANCER_ENGINE_<KEY>_* where <KEY> is the key
# uppercased with dashes turned into underscores.
ENHANCER_ENGINES=ds4-flash,pe-t2i,pe-i2i
# Engine selected in the UI on first load.
ENHANCER_ENGINE=ds4-flash

# --- ds4-flash: an ordinary chat model, answers with plain prompt text. -------
# The legacy ENHANCER_* variables below still override this first engine, so an
# older .env keeps working unchanged.
ENHANCER_ENGINE_DS4_FLASH_LABEL=ds4-flash (router)
ENHANCER_ENGINE_DS4_FLASH_KIND=chat
ENHANCER_ENGINE_DS4_FLASH_BASE_URL=https://router.pixel-space.co/v1
ENHANCER_ENGINE_DS4_FLASH_MODEL=ds4-flash
#ENHANCER_ENGINE_DS4_FLASH_API_KEY=sk-your-router-key

# --- pe-t2i: a Qwen-Image-2.1-PE checkpoint served by vLLM. -----------------
# A PE engine answers with {"rewritten_prompt": ..., "wh_ratio": ...}. The UI shows
# the ratio and offers the matching native size. PE checkpoints have no edit
# prompt, so this engine is disabled on the Edit tab.
ENHANCER_ENGINE_PE_T2I_LABEL=Qwen-Image-2.1-PE-T2I
ENHANCER_ENGINE_PE_T2I_KIND=pe
ENHANCER_ENGINE_PE_T2I_BASE_URL=http://10.0.151.2:8104/v1
ENHANCER_ENGINE_PE_T2I_MODEL=Qwen/Qwen-Image-2.1-PE-T2I
#ENHANCER_ENGINE_PE_T2I_API_KEY=
# The PE checkpoints ship their task prompt next to the weights rather than in a
# repo, so a copy of the T2I prompt is bundled under prompts/.
ENHANCER_ENGINE_PE_T2I_SYSTEM_PROMPT_FILE=prompts/pe_t2i_system_prompt.txt
# Upstream t2i production sampling profile.
ENHANCER_ENGINE_PE_T2I_TEMPERATURE=1.0
ENHANCER_ENGINE_PE_T2I_TOP_P=0.95
ENHANCER_ENGINE_PE_T2I_TOP_K=20
ENHANCER_ENGINE_PE_T2I_MIN_P=0.0
ENHANCER_ENGINE_PE_T2I_PRESENCE_PENALTY=1.5
ENHANCER_ENGINE_PE_T2I_MAX_TOKENS=16256
ENHANCER_ENGINE_PE_T2I_TIMEOUT_S=900
ENHANCER_ENGINE_PE_T2I_SEED=42
# vLLM `chat_template_kwargs.enable_thinking`; blank or unset lets the
# checkpoint's chat template decide (which is what upstream's edit body does).
#ENHANCER_ENGINE_PE_T2I_ENABLE_THINKING=true

# --- pe-i2i: the Qwen-Image-2.1-PE-I2I edit checkpoint. --------------------
# The edit checkpoint reads the reference images next to the instruction and answers
# with {"rewritten_prompt": ..., "wh_ratio": ...} or, when the render should keep
# a source image's shape, {"rewritten_prompt": ..., "ratio_follow": "<imageN>"}.
# It ships an edit prompt only, so this engine is disabled on the Generate tab and
# the UI asks for at least one reference image before enhancing an edit.
ENHANCER_ENGINE_PE_I2I_LABEL=Qwen-Image-2.1-PE-I2I
ENHANCER_ENGINE_PE_I2I_KIND=pe-i2i
ENHANCER_ENGINE_PE_I2I_BASE_URL=http://10.0.151.2:8105/v1
ENHANCER_ENGINE_PE_I2I_MODEL=Qwen/Qwen-Image-2.1-PE-I2I
#ENHANCER_ENGINE_PE_I2I_API_KEY=
ENHANCER_ENGINE_PE_I2I_EDIT_SYSTEM_PROMPT_FILE=prompts/pe_i2i_system_prompt.txt
# The edit checkpoint is multimodal; the reference images go in the user message.
ENHANCER_ENGINE_PE_I2I_IMAGE_INPUTS=true
# Upstream edit profile.
ENHANCER_ENGINE_PE_I2I_TEMPERATURE=1.0
ENHANCER_ENGINE_PE_I2I_TOP_P=0.95
ENHANCER_ENGINE_PE_I2I_TOP_K=20
ENHANCER_ENGINE_PE_I2I_MIN_P=0.0
ENHANCER_ENGINE_PE_I2I_PRESENCE_PENALTY=0.0
ENHANCER_ENGINE_PE_I2I_MAX_TOKENS=24000
ENHANCER_ENGINE_PE_I2I_TIMEOUT_S=900
ENHANCER_ENGINE_PE_I2I_SEED=42

# Legacy single-engine overrides, kept for older .env files. They apply to the
# first engine in ENHANCER_ENGINES only.
ENHANCER_BASE_URL=https://router.pixel-space.co/v1
ENHANCER_CHAT_PATH=/chat/completions
ENHANCER_MODEL=ds4-flash
ENHANCER_API_KEY=sk-your-router-key
ENHANCER_MODELS=ds4-flash
ENHANCER_TEMPERATURE=0.7
ENHANCER_MAX_TOKENS=700
ENHANCER_TIMEOUT_S=120
ENHANCER_SYSTEM_PROMPT=You are an expert prompt engineer for the Qwen-Image-2.1 text-to-image diffusion model. Rewrite the user's rough idea into one single, vivid, production-ready image prompt. Rules: reply with the prompt text only - no preamble, no explanations, no markdown, no bullet points, no quotation marks around the whole prompt, no negative-prompt section. Write one dense paragraph of 60 to 140 words. Always cover: subject and action, composition and camera angle, lighting, materials and textures, colour palette, mood and atmosphere, environment or background, and rendering style. Prefer concrete visual nouns over abstract adjectives. Keep any text that must appear in the image exactly as written, wrapped in double quotes. Never add watermarks, signatures, borders, extra limbs or duplicated subjects. If transparency or a sticker is requested, state that the image is an RGBA image with transparency and a transparent background. Preserve the user's intent: never change subject, subject count, or a style that was explicitly requested.
ENHANCER_EDIT_SYSTEM_PROMPT=You are an expert prompt engineer for the Qwen-Image-2.1 image-editing model. The user supplies one or more reference images plus an edit instruction. Rewrite that instruction into a single, precise, production-ready edit prompt. Rules: reply with the prompt text only - no preamble, no explanations, no markdown, no quotation marks around the whole prompt. State the change to apply, exactly where it goes, and how it integrates with the existing scene: perspective, lighting, shadows, scale, materials and reflections. State clearly what must stay unchanged. Keep any in-image text in double quotes. 60 to 120 words.

ENHANCER_PRESETS=enhance,photoreal,cinematic,illustration,product,sticker
ENHANCER_PRESET_ENHANCE=Maximise overall fidelity: enrich subject detail, lighting, composition, materials and atmosphere while keeping the original intent intact.
ENHANCER_PRESET_PHOTOREAL=Make it photorealistic: natural lighting, true-to-life materials, shallow depth of field, subtle skin and surface imperfections, 85mm lens look.
ENHANCER_PRESET_CINEMATIC=Give it a cinematic film-still look: dramatic key light, volumetric haze, anamorphic framing, rich colour grade, movie-poster mood.
ENHANCER_PRESET_ILLUSTRATION=Render it as a polished digital illustration: clean line work, flat shaded colour, expressive shapes, storybook charm.
ENHANCER_PRESET_PRODUCT=Turn it into a premium studio product shot: seamless backdrop, soft-box lighting, crisp reflections, catalogue-ready composition.
ENHANCER_PRESET_STICKER=Make it a cute sticker design: bold clean outlines, flat vibrant colours, simple shapes, subject isolated on a transparent background.

SIZES=1024x1024,2048x2048,2752x1536,1536x2752,2400x1792,1792x2400,2528x1696,1696x2528
DEFAULT_SIZE=1024x1024
DEFAULT_STEPS=40
DEFAULT_GUIDANCE_SCALE=1.0
DEFAULT_OUTPUT_FORMAT=png
IMAGE_RESPONSE_FORMAT=b64_json
MAX_REFERENCE_IMAGES=10
IMAGE_TIMEOUT_S=900
ENHANCER_APPLY_BY_DEFAULT=false

APP_HOST=127.0.0.1
APP_PORT=7860
CORS_ORIGINS=*
HEALTH_TIMEOUT_S=15
